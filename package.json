{
  "name": "@wyattjoh/astro-cache",
  "version": "2.1.2",
  "description": "Astro integration providing disk-backed caching utilities with stale-while-revalidate and memoization support",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/wyattjoh/astro-cache.git"
  },
  "homepage": "https://github.com/wyattjoh/astro-cache#readme",
  "bugs": {
    "url": "https://github.com/wyattjoh/astro-cache/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest",
    "provenance": true
  },
  "exports": {
    ".": "./dist/index.js",
    "./cache": "./dist/cache.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT",
  "author": "Wyatt Johnson",
  "scripts": {
    "build": "bunup src/index.ts src/cache.ts --format esm --dts --sourcemap --clean --external astro:env/server",
    "test": "bun test --concurrent src/",
    "typecheck": "tsc -p . --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "husky",
    "prepack": "bun run build"
  },
  "keywords": [
    "astro-integration",
    "cache",
    "swr",
    "withastro"
  ],
  "dependencies": {
    "flat-cache": "^6.1.22",
    "stale-while-revalidate-cache": "^3.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/bun": "^1.3.13",
    "astro": "^6.3.1",
    "bunup": "^0.16.31",
    "husky": "^9.1.7",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "astro": "^6.3.1"
  }
}
